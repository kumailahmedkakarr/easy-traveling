# Copy this file to ".env" and fill in your own values.
# You can also run WITHOUT this file: everything has a safe default for testing.

PORT=3000
NODE_ENV=development

# ---------- Where is the data kept? ----------
#   memory = NO database needed (testing only). Saved in server/data/dev-data.json.
#            On Vercel nothing can be saved in this mode, so use MySQL there.
#   mysql  = real MySQL database
# If you set DATABASE_URL (or DB_HOST) and leave DB_DRIVER empty, MySQL is used automatically.
DB_DRIVER=memory

# ---------- MySQL: option 1, one link (easiest, works on Vercel) ----------
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME?ssl=true

# ---------- MySQL: option 2, separate values ----------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=easetraveling
# DB_SSL=false

# ---------- Admin panel ----------
# The admin panel opens ONLY at https://your-site/<ADMIN_PATH>/  (nothing on the website links to it).
# Choose a long secret word (6-60 letters, digits, - or _).
ADMIN_PATH=secret-admin
# Admin login. Changing the password here changes it in the database at the next start.
ADMIN_EMAIL=admin@easetraveling.pk
ADMIN_PASSWORD=Admin@12345

# Long random text used to sign admin login tokens (REQUIRED in production)
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=8

# true = adds 2 sample bookings on the first run (development only)
SEED_DEMO_DATA=true

# Fixed service fee added to every bus booking (Rs.)
SERVICE_FEE=500

# ---------- Where customers send money (shown on the website and the ticket) ----------
PAY_EASYPAISA=03363739610
PAY_BANK_NAME=Bank Al Falah
PAY_BANK_ACCOUNT=00601004849348

# ---------- Contact details on the Contact page (leave empty to keep the defaults) ----------
SUPPORT_PHONE=
# WhatsApp number with country code, digits only (example: 923001234567)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
