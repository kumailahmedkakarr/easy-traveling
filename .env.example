# Copy this file to ".env" and fill in your own values.
# You can also run WITHOUT this file: everything has a safe default for testing.

PORT=3000
NODE_ENV=development

# ---------- Where is the data kept? ----------
#   memory = NO database needed (testing). Data is saved in server/data/dev-data.json
#   mysql  = real MySQL database (fill in the MySQL section below)
DB_DRIVER=memory

# ---------- MySQL (only used when DB_DRIVER=mysql) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=easetraveling
# Cloud MySQL (Aiven, Railway...) usually needs this:
DB_SSL=false

# ---------- Admin panel ----------
# The admin panel opens ONLY at http://localhost:3000/<ADMIN_PATH>/  (nothing on the website links to it).
# Choose a long secret word (6-60 letters, digits, - or _).
ADMIN_PATH=secret-admin
# Admin login. Changing the password here changes it in the database at the next start.
ADMIN_EMAIL=admin@easetraveling.pk
ADMIN_PASSWORD=Admin@12345

# Long random text used to sign admin login tokens (REQUIRED in production)
AUTH_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=8

# true = adds 2 sample bookings on the first run (development only)
SEED_DEMO_DATA=true

# Fixed service fee added to every bus booking (Rs.)
SERVICE_FEE=500

# ---------- Support contacts shown on the website (leave empty to hide) ----------
SUPPORT_PHONE=
# WhatsApp number with country code, digits only (example: 923001234567)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
